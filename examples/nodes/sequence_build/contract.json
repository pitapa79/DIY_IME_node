            "meta": {
              "reading": "よみ",
              "sourceSpan": [
                3,
                7
              ]
            }
          }
        ]
      },
      "a": {
        "type": "choice",
        "options": [
          {
            "value": {
              "type": "text",
              "text": "甲",
              "meta": {
                "reading": "よみ",
                "sourceSpan": [
                  3,
                  7
                ]
              }
            },
            "score": -2.5
          },
          {
            "value": {
              "type": "text",
              "text": "乙"
            }
          }
        ]
      },
      "b": {
        "type": "text",
        "text": "é"
      },
      "expected": {
        "type": "sequence",
        "items": [
          {
            "type": "text",
            "text": "𠮷🙂",
            "meta": {
              "reading": "よみ",
              "sourceSpan": [
                3,
                7
              ]
            }
          },
          {
            "type": "choice",
            "options": [
              {
                "value": {
                  "type": "text",
                  "text": "甲",
                  "meta": {
                    "reading": "よみ",
                    "sourceSpan": [
                      3,
                      7
                    ]
                  }
                },
                "score": -2.5
              },
              {
                "value": {
                  "type": "text",
                  "text": "乙"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": "é"
          }
        ]
      }
    },
    {
      "id": "configured-nesting-kept",
      "config": {
        "items": [
          {
            "type": "sequence",
            "items": []
          },
          {
            "type": "choice",
            "options": []
          }
        ]
      },
      "a": {
        "type": "text",
        "text": ""
      },
      "expected": {
        "type": "sequence",
        "items": [
          {
            "type": "sequence",
            "items": []
          },
          {
            "type": "choice",
            "options": []
          },
          {
            "type": "text",
            "text": ""
          }
        ]
      }
    }
  ]
}
