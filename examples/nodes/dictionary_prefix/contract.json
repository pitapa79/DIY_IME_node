{
  "kind": "experimental.text-dictionary-prefix",
  "version": 1,
  "dictionary": "dictionary.tsv",
  "defaultConfig": {
    "path": "dictionary.tsv",
    "limit": 64
  },
  "cases": [
    {
      "id": "prefix-includes-exact-and-longer-readings",
      "input": "ほん",
      "expected": [
        {
          "text": "本",
          "score": 10
        },
        {
          "text": "本気",
          "score": 50
        },
        {
          "text": "本木",
          "score": 5
        },
        {
          "text": "本日",
          "score": 100
        },
        {
          "text": "本実",
          "score": 20
        }
      ]
    },
    {
      "id": "narrower-prefix",
      "input": "ほんじ",
      "expected": [
        {
          "text": "本日",
          "score": 100
        },
        {
          "text": "本実",
          "score": 20
        }
      ]
    },
    {
      "id": "exact-reading-keeps-row-order-not-score-order",
      "input": "こうすい",
      "expected": [
        {
          "text": "降水",
          "score": 90
        },
        {
          "text": "香水",
          "score": 30
        },
        {
          "text": "洪水",
          "score": 90
        }
      ]
    },
    {
      "id": "empty-input-is-empty-choice",
      "input": "",
      "expected": []
    },
    {
      "id": "no-match-is-empty-choice",
      "input": "そんざい",
      "expected": []
    },
    {
      "id": "limit-truncates-in-defined-order",
      "input": "ほ",
      "config": {
        "path": "dictionary.tsv",
        "limit": 2
      },
      "expected": [
        {
          "text": "本",
          "score": 10
        },
        {
          "text": "本気",
          "score": 50
        }
      ]
    },
    {
      "id": "non-bmp-surface",
      "input": "よ",
      "expected": [
        {
          "text": "𠮷",
          "score": 1
        }
      ]
    }
  ],
  "invalidConfigs": [
    {
      "path": "dictionary.tsv"
    },
    {
      "path": "dictionary.tsv",
      "limit": 0
    },
    {
      "path": "dictionary.tsv",
      "limit": 1025
    },
    {
      "path": "dictionary.tsv",
      "limit": "64"
    },
    {
      "limit": 64
    },
    {
      "path": "",
      "limit": 64
    },
    {
      "path": "dictionary.tsv",
      "limit": 64,
      "unknown": 1
    }
  ]
}
