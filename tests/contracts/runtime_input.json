    {"id": "same-plan-new-input", "input": {"revision": 2, "text": "kya", "mode": "compose"}, "expected": {"status": "data", "planVersion": 1, "inputRevision": 2, "packet": {"version": 1, "root": {"type": "text", "text": "kya"}}}},
    {"id": "empty-is-data", "input": {"revision": 3, "text": "", "mode": "compose"}, "expected": {"status": "data", "inputRevision": 3, "packet": {"version": 1, "root": {"type": "text", "text": ""}}}},
    {"id": "unicode", "input": {"revision": 4, "text": "𠮷30%", "mode": "finalize"}, "expected": {"status": "data", "inputRevision": 4, "packet": {"version": 1, "root": {"type": "text", "text": "𠮷30%"}}}},
