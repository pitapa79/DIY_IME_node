    {"id": "ignored-empty-branch", "packet": {"version": 1, "root": {"type": "choice", "options": [{"score": 1, "value": {"type": "text", "text": "保持"}}, {"score": 0, "value": {"type": "choice", "options": []}}]}}, "expected": {"status": "data", "packet": {"version": 1, "root": {"type": "text", "text": "保持"}}}},
